{
  "name": "SnapFoley",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [7860],
  "portsAttributes": {
    "7860": {
      "label": "SnapFoley Web UI",
      "onAutoForward": "openBrowser"
    }
  }
}
